# MongoDB connection string
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.grwvfmy.mongodb.net/Bitumen_Project

# Port for your backend server
PORT=<port>

# JWT and secret tokens
JWT_SECRET=<your_jwt_secret>
SESSION_SECRET=<your_session_secret>
CAPTCHA_SECRET=<your_captcha_secret>
FLASK_SECRET_CODE=<your_flask_secret_code>
JWT_SECRET_ADMIN=<your_jwt_admin_secret>

# Admin password
ADMIN_PASSWORD=<your_admin_password>

# Email service API key
SENDGRID_API_KEY=<your_sendgrid_api_key>

# GitHub OAuth
GITHUB_CLIENT_ID=<your_github_client_id>

# Client URL for frontend app
CLIENT_URL=<your_client_url>

# Environment settings
NODE_ENV=development

# Flask backend URL
FLASK_BACKEND_URL=<your_flask_backend_url>

# Google OAuth credentials
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>

# Base URL for the backend
BASE_URL=<your_base_url>
